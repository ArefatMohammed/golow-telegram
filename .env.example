# Copy to .env for local development. Never commit .env.

# @GolowBidDevBot for dev, @GolowBidBot for production (from @BotFather).
BOT_TOKEN=

# Backend API (with /api/v1). Dev: https://api-dev.golow.et/api/v1 — prod: https://api.golow.et/api/v1
GOLOW_API_URL=https://api-dev.golow.et/api/v1

# Same value as the backend's Telegram__InternalKey (at least 32 characters).
INTERNAL_KEY=

# Mini App the "Open GOLOW" buttons launch.
MINIAPP_URL=https://dev.golow.et/tg

# Webhook mode (servers): public HTTPS URL of /telegram/webhook and a random secret.
# Leave WEBHOOK_URL empty to use long polling: python -m golow_telegram polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Set the bot's commands and menu button on start-up.
SETUP_BOT_PROFILE=true

# --- GOLOW Live Studio (served on STUDIO_HOST, sign-in with GOLOW admin credentials) ---
# Random secret, at least 32 characters (e.g. `openssl rand -hex 32`). Leave empty to turn the studio off.
# Rotating it signs everyone out and invalidates every OBS scene link.
STUDIO_SECRET=
# Dev: live-dev.golow.et (with the dev API above) — prod: live.golow.et (with https://api.golow.et/api/v1)
STUDIO_HOST=live.golow.et
STUDIO_SESSION_HOURS=12
STUDIO_SCENE_KEY_DAYS=30
# Only for local development over plain http:
# STUDIO_COOKIE_SECURE=false
