# Copy to .env (or .env.dev / .env.prod on the server). Never commit it.

# dev or prod. Picks every GOLOW address at once:
#   dev  → api-dev.golow.et, dev.golow.et/tg, @GolowBidDevBot, studio on live-dev.golow.et
#   prod → api.golow.et,     golow.et/tg,     @GolowBidBot,    studio on live.golow.et
# The service refuses to start when ENVIRONMENT=prod points at the dev API (or the reverse).
ENVIRONMENT=dev

# The token of that environment's bot, from @BotFather.
BOT_TOKEN=

# Same value as that environment's backend Telegram__InternalKey (at least 32 characters).
INTERNAL_KEY=

# Webhook mode (servers): public HTTPS URL of /telegram/webhook and a random secret.
# Leave WEBHOOK_URL empty to use long polling (local development).
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- GOLOW Live Studio ---
# Random secret, at least 32 characters (`openssl rand -hex 32`); a different one per environment.
# Empty: studio off. Rotating it signs everyone out and invalidates every OBS scene link.
STUDIO_SECRET=
STUDIO_SESSION_HOURS=12
STUDIO_SCENE_KEY_DAYS=30
# Only for local development over plain http:
# STUDIO_COOKIE_SECURE=false

# --- Overrides (normally left out: ENVIRONMENT sets them) ---
# GOLOW_API_URL=https://api-dev.golow.et/api/v1
# MINIAPP_URL=https://dev.golow.et/tg
# WEBSITE_URL=https://dev.golow.et
# BOT_USERNAME=GolowBidDevBot
# STUDIO_HOST=live-dev.golow.et
# SETUP_BOT_PROFILE=true
